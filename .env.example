# ---------------------------------------------------------------------------
# Careers datastore (Firebase Admin SDK)
# Copy to `.env.local` for local development. Never commit `.env.local`.
#
# On Vercel these belong in Project Settings -> Environment Variables. Leave
# them unset locally to fall back to Application Default Credentials
# (`gcloud auth application-default login`) or the Firebase emulator.
# All three must be set together or not at all.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the key wrapped in quotes and escape newlines as \n.
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Firestore database to use. This project has a Native database named "default"
# in asia-south1; firebase-admin's implicit target is the special "(default)"
# database, which does not exist, so the id is passed explicitly. Only change
# this if you create a differently named database.
CAREERS_FIRESTORE_DATABASE_ID=default

# ---------------------------------------------------------------------------
# Careers authorization
# ---------------------------------------------------------------------------
# Comma, space, or semicolon separated allowlist of email addresses that may
# call the write APIs. Leave empty to reject every write.
#
# This is deliberately separate from CAREERS_ADMIN_USERS in the admin app. The
# public app only verifies a signature and checks this list; it never holds a
# password hash and cannot mint a session.
CAREERS_ADMIN_EMAILS=

# Shared secret that verifies admin session tokens, minted by the admin app.
# Must be at least 32 characters and byte-identical to the admin app's value.
# Generate with: openssl rand -base64 48
#
# Rotate together with the admin app's CAREERS_SESSION_SECRET. Rotating either
# one alone invalidates every existing session, which is the intended effect.
CAREERS_SESSION_SECRET=

# Signs five-minute preview links for drafts and closed jobs. Must be at least
# 32 characters. Generate with: openssl rand -hex 32
CAREERS_PREVIEW_SECRET=

# ---------------------------------------------------------------------------
# Careers listing
# ---------------------------------------------------------------------------
# Public page size for the careers board. Clamped to 1-100; defaults to 12.
CAREERS_PAGE_SIZE=

# ---------------------------------------------------------------------------
# Contact form email (SMTP)
# ---------------------------------------------------------------------------
EMAIL_USER=
EMAIL_PASS=
