rules_version = '2';

// The careers datastore is only ever reached through the Next.js server
// (firebase-admin), which bypasses these rules entirely. No browser client in
// this repository talks to Firestore directly, so every path is denied here.
//
// If a future feature needs client-side reads, allow them explicitly for the
// published-jobs path only rather than opening up the `jobs` collection.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
