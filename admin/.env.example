# ---------------------------------------------------------------------------
# Careers Admin (admin.soonlay.tech) environment
# Copy to `.env.local` for local development. Never commit `.env.local`.
#
# The admin portal has no Firebase dependency. It authenticates against the
# credentials below and talks to the public app's API over CAREERS_API_URL.
# ---------------------------------------------------------------------------

# Comma, space, or semicolon separated allowlist of sign-in addresses. Used to
# label the configured operators, not to grant access; access is controlled by
# the password hashes in CAREERS_ADMIN_USERS.
CAREERS_ADMIN_EMAILS=

# Signs and verifies five-day session cookies. Must be at least 32 characters
# and byte-identical to the public app's CAREERS_SESSION_SECRET, or every
# session will be rejected.
# Generate with: openssl rand -base64 48
CAREERS_SESSION_SECRET=

# Comma, space, or newline separated list of `email:passwordHash` pairs. The
# hash is scrypt, so the plaintext password is never stored anywhere.
#
# Generate an entry with:
#   npm run hash-password -- 'the-new-password'
#
# Separators inside a hash are `$`, so keep one pair per comma-separated entry
# and do not add spaces around the colon. Entries that are malformed or whose
# hash is not a scrypt hash are rejected; if no valid entry remains, sign-in
# fails closed rather than falling back to a default account.
#
#   CAREERS_ADMIN_USERS=admin@soonlay.com:scrypt\$32768\$8\$1\$<salt>\$<hash>
#
# Escape the `$` as `\$` here. Next.js expands `$NAME` while reading a .env
# file, and a scrypt hash is full of `$` separators, so an unescaped value is
# silently truncated to `admin@soonlay.com:scrypt` and every sign-in fails.
# Values typed into the Vercel dashboard are not expanded and need no escaping.
# `npm run hash-password` prints both forms.
CAREERS_ADMIN_USERS=

# Base URL of the public app, without a trailing slash. The admin portal calls
# the write APIs here and forwards its own session cookie as the bearer token.
CAREERS_API_URL=https://soonlay.tech
